{
  "name": "Task",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "enum": [
        "Physics",
        "Chemistry",
        "Mathematics"
      ],
      "enumColors": [
        "blue",
        "purple",
        "pink"
      ]
    },
    "chapter_name": {
      "type": "string"
    },
    "target_minutes": {
      "type": "number",
      "default": 45
    },
    "status": {
      "type": "string",
      "enum": [
        "Todo",
        "In Progress",
        "Done"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green"
      ],
      "default": "Todo"
    }
  },
  "required": [
    "date",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}